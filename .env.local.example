# Copy this file to .env.local for local development, and add the same
# two variables in Vercel → Project Settings → Environment Variables for
# production.
#
# GMAIL_USER: the Gmail address the contact form will send FROM and TO
# (i.e. your own inbox).
#
# GMAIL_APP_PASSWORD: a 16-character Google "App Password", NOT your
# normal Gmail password. Generate one at:
# https://myaccount.google.com/apppasswords
# (requires 2-Step Verification to be enabled on the account)

GMAIL_USER=youraddress@gmail.com
GMAIL_APP_PASSWORD=your16characterapppassword
